# Backend external configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://studio:studio@postgres:5432/studio

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:5173

# Internal services
AI_ENGINE_URL=http://ai-engine:8080
AI_ENGINE_SERVICE_TOKEN=
FILM_RUNTIME_URL=http://film-runtime:8081
FILM_RUNTIME_SERVICE_TOKEN=

# Storage
AWS_REGION=ap-south-1
S3_BUCKET=
