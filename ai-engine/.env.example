# AI Engine external configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Executor/provider selection
AI_EXECUTOR_FACTORY=integration
MODEL_PROVIDER=ollama

# Model selection (change without rebuilding the image)
LLM_MODEL=qwen2.5:7b
IMAGE_MODEL=flux
VIDEO_MODEL=wan
STT_MODEL=whisper-large-v3
TTS_MODEL=kokoro
TRANSLATION_MODEL=nllb
LIPSYNC_MODEL=wav2lip
EMBEDDING_MODEL=nomic-embed-text
RERANKER_MODEL=

# Provider endpoints
OLLAMA_BASE_URL=http://localhost:11434
AI_PROVIDER_BASE_URL=

# Secrets: inject externally; never commit real values
AI_PROVIDER_API_KEY=
AI_ENGINE_SERVICE_TOKEN=

# Runtime limits
AI_REQUEST_TIMEOUT_SECONDS=600
AI_MAX_CONCURRENT_JOBS=1
