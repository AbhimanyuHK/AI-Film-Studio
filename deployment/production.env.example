# Production secret/configuration contract.
# Do not commit real values. Store these in AWS Secrets Manager / SSM or the CI secret store.

APP_ENV=production
AUTH_MODE=production
JWT_ALGORITHM=HS256
JWT_SECRET=<32+ character secret>
JWT_ISSUER=<configured issuer>
JWT_AUDIENCE=<configured audience>
DATABASE_URL=<private PostgreSQL connection string>
FRONTEND_CORS_ORIGINS=https://<production-frontend-domain>
AI_ENGINE_URL=http://<internal-ai-engine>
AI_ENGINE_TIMEOUT_SECONDS=1800
AI_ENGINE_SHARED_SECRET=<service-to-service secret>
FILM_RUNTIME_URL_TEMPLATE=https://<runtime-routing-host>/{film_id}/{environment_id}
FILM_RUNTIME_SHARED_SECRET=<runtime service secret>
AWS_REGION=<region>
S3_BUCKET=<film-artifact-bucket>

# AI provider configuration is deployment-specific.
# In production AI_EXECUTOR_FACTORY must point to the real provider-backed executor.
AI_EXECUTOR_FACTORY=<module:function>
