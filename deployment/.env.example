# Deployment environment (never commit real secrets)
ENVIRONMENT=staging
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=

# Terraform
TF_STATE_BUCKET=
TF_STATE_LOCK_TABLE=
TF_VAR_name_prefix=ai-film-studio
TF_VAR_film_id=
TF_VAR_environment_id=

# Production services
AI_ENGINE_SERVICE_TOKEN=
FILM_RUNTIME_SERVICE_TOKEN=
JWT_SECRET=

# AI model defaults
MODEL_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
IMAGE_MODEL=flux
VIDEO_MODEL=wan
STT_MODEL=whisper-large-v3
TTS_MODEL=kokoro
TRANSLATION_MODEL=nllb
LIPSYNC_MODEL=wav2lip

# Provider credentials - inject from AWS Secrets Manager/CI
AI_PROVIDER_API_KEY=
