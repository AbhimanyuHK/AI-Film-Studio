# Worker external configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Control-plane database
DATABASE_URL=postgresql+asyncpg://studio:studio@postgres:5432/studio

# Worker identity/lease
WORKER_ID=local-worker
WORKER_LEASE_SECONDS=300
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_MAX_RETRIES=3
WORKER_CONCURRENCY=1

# AI Engine
AI_ENGINE_URL=http://ai-engine:8080
AI_ENGINE_SERVICE_TOKEN=

# Film Runtime
FILM_RUNTIME_URL=http://film-runtime:8081
FILM_RUNTIME_SERVICE_TOKEN=

# Storage
AWS_REGION=ap-south-1
S3_BUCKET=
